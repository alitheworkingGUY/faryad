# Copy to .env.local and fill in.

# Required for the voice agent, the Urdu voice note and AI incident summaries.
OPENAI_API_KEY=

# Voice agent (browser <-> OpenAI Realtime over WebRTC)
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
# Transcription of the caller. "ur" keeps Urdu in Urdu script; leave empty to auto-detect.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TRANSCRIBE_LANGUAGE=ur

# Urdu voice note sent to the citizen when a ticket is resolved
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Text model used for incident summaries and live field extraction
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# The https URL printed by `cloudflared tunnel --url http://localhost:3000`.
# Used in every QR code. Leave empty to fall back to the address in the browser.
PUBLIC_BASE_URL=
